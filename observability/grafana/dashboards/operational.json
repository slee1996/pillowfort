{
  "uid": "pillowfort-operational",
  "title": "Pillowfort · Operations and room volume",
  "description": "Allowlisted HTTP traces and unsampled aggregate room/application-event counts. Best-effort operational signals, not billing, unique-user, or chat-only analytics.",
  "tags": ["pillowfort", "operational"],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "environment", "label": "Environment", "type": "custom",
        "query": "production,development,test", "multi": false,
        "current": {"text": "production", "value": "production"},
        "options": [
          {"text": "production", "value": "production", "selected": true},
          {"text": "development", "value": "development", "selected": false},
          {"text": "test", "value": "test", "selected": false}
        ]
      },
      {
        "name": "service", "label": "Service", "type": "custom",
        "query": "pillowfort.app,pillowfort.marketing,pillowfort.hosted-mcp",
        "multi": true, "includeAll": true, "allValue": "pillowfort[.](app|marketing|hosted-mcp)",
        "current": {"text": "All", "value": "$__all"},
        "options": [
          {"text": "All", "value": "$__all", "selected": true},
          {"text": "pillowfort.app", "value": "pillowfort.app", "selected": false},
          {"text": "pillowfort.marketing", "value": "pillowfort.marketing", "selected": false},
          {"text": "pillowfort.hosted-mcp", "value": "pillowfort.hosted-mcp", "selected": false}
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "Coverage and interpretation",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "markdown",
        "content": "**Received HTTP spans—not total product activity.** These HTTP panels exclude Room/WebSocket traffic; aggregate room volume is shown separately below. HTTP sampling is not extrapolated; empty charts do not prove zero traffic. Errors mean HTTP 5xx. Test data is isolated by environment. Retention: approximately 7 days. Collector counters reset on restart."
      }
    },
    {
      "id": 2, "type": "timeseries", "title": "Received requests / second",
      "gridPos": {"x": 0, "y": 3, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{
        "refId": "A", "exemplar": true,
        "expr": "sum by (service_name, pillowfort_operation) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval]))",
        "legendFormat": "{{service_name}} · {{pillowfort_operation}}"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "HTTP 5xx error ratio",
      "gridPos": {"x": 12, "y": 3, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{
        "refId": "A",
        "expr": "(sum by (service_name) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval]))) / sum by (service_name) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval]))",
        "legendFormat": "{{service_name}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Request duration · p50 / p95",
      "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "refId": "A", "exemplar": true,
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(pillowfort_operational_duration_seconds_bucket{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} · p50"
        },
        {
          "refId": "B", "exemplar": true,
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(pillowfort_operational_duration_seconds_bucket{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} · p95"
        }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Received HTTP 5xx / second",
      "gridPos": {"x": 12, "y": 11, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{
        "refId": "A", "exemplar": true,
        "expr": "sum by (service_name, pillowfort_operation) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (service_name, pillowfort_operation) (rate(pillowfort_operational_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\"}[$__rate_interval]))",
        "legendFormat": "{{service_name}} · {{pillowfort_operation}}"
      }]
    },
    {
      "id": 6, "type": "table", "title": "Operational traces · up to 20 matches",
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 10},
      "datasource": {"type": "tempo", "uid": "pillowfort-tempo"},
      "options": {"showHeader": true},
      "targets": [{
        "refId": "A", "queryType": "traceql", "tableType": "traces", "limit": 20,
        "query": "{ resource.service.name =~ \"$service\" && resource.deployment.environment.name = \"$environment\" && name = \"http.server.request\" }"
      }]
    },
    {
      "id": 7, "type": "text", "title": "Room and encrypted-message volume",
      "gridPos": {"x": 0, "y": 29, "w": 24, "h": 4},
      "options": {
        "mode": "markdown",
        "content": "**App-only, unsampled count events—not chat transcripts.** Encrypted application events include chat, presence, typing, drawing and games; the relay cannot distinguish their contents. New admissions exclude founders and resumes. Retries, delivery ACKs, replay backlogs and recipient fanout do not add message counts. Stat totals are received events since the collector reset, not all-time totals or selected-range totals. Rate charts use the time picker. Export can drop events; missing data is not zero. No historical backfill, per-room identities, or active-room estimates."
      }
    },
    {
      "id": 8, "type": "stat", "title": "Rooms created · collector total",
      "gridPos": {"x": 0, "y": 33, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "noValue": "No telemetry"}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"refId": "A", "instant": true, "expr": "sum(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=\"room.created\"})"}]
    },
    {
      "id": 9, "type": "stat", "title": "Rooms retired · collector total",
      "gridPos": {"x": 6, "y": 33, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "noValue": "No telemetry"}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"refId": "A", "instant": true, "expr": "sum(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=\"room.retired\"})"}]
    },
    {
      "id": 10, "type": "stat", "title": "New member admissions · collector total",
      "gridPos": {"x": 12, "y": 33, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "noValue": "No telemetry"}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"refId": "A", "instant": true, "expr": "sum(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=\"member.admitted\"})"}]
    },
    {
      "id": 11, "type": "stat", "title": "Encrypted application events · collector total",
      "gridPos": {"x": 18, "y": 33, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "min": 0, "noValue": "No telemetry"}, "overrides": []},
      "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"refId": "A", "instant": true, "expr": "sum(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=\"application.accepted\"})"}]
    },
    {
      "id": 12, "type": "timeseries", "title": "Accepted encrypted application events / second",
      "gridPos": {"x": 0, "y": 38, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"refId": "A", "expr": "sum(rate(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=\"application.accepted\"}[$__rate_interval]))", "legendFormat": "accepted encrypted application events"}]
    },
    {
      "id": 13, "type": "timeseries", "title": "Room lifecycle and admissions / second",
      "gridPos": {"x": 12, "y": 38, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "pillowfort-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"refId": "A", "expr": "sum by (pillowfort_activity) (rate(pillowfort_volume_calls_total{service_name=~\"$service\",deployment_environment_name=\"$environment\",pillowfort_activity=~\"room[.](created|retired)|member[.]admitted\"}[$__rate_interval]))", "legendFormat": "{{pillowfort_activity}}"}]
    }
  ],
  "links": [{"title": "Trace lookup in Explore", "url": "/explore?left=%7B%22datasource%22%3A%22pillowfort-tempo%22%7D", "targetBlank": false}]
}
