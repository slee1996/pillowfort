{
  "name": "pillowfort-hosted-mcp",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/security.test.mjs",
    "check": "npm run typecheck && bun ../scripts/check-agent-catalog.ts --runtime hosted && npm test && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
